# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private Google account UUID (server-only; npm run admin:setup also syncs DB RLS)
TRAINI_ADMIN_USER_ID=

# Weather
WEATHER_API_KEY=

# Run the saved Garmin collector on this Mac only (never expose tokens to the browser)
TRAINI_LOCAL_COLLECTOR_ENABLED=false
TRAINI_COLLECTOR_PYTHON=/absolute/path/to/traini/collector/.venv/bin/python
TRAINI_TIMEZONE=America/Los_Angeles
